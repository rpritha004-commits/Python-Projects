name=input("Enter student name:")
marks=[]
for i in range(5):
  mark=float(input("enter mark{i+1}:"))
  marks.append(mark)
total=sum(marks)
average=total/5
if average>=90:
  grade="A"
elif average>=75:
  grade="B"
elif average>=50:
  grade="C"
else:
  grade="Fail"
print("\nStudent:",name)
print("Total:",total)
print("Average:",average)
print("grade:".grade)
